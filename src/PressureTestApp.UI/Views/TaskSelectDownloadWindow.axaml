<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PressureTestApp.UI.ViewModels"
        xmlns:models="using:PressureTestApp.Communication.Models"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="PressureTestApp.UI.Views.TaskSelectDownloadWindow"
        x:DataType="vm:TaskDownloadSelectViewModel"
        Width="980" Height="560"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="#FF2C2E33"
        FontFamily="{StaticResource DefaultFont}"
        Title="任务下载选择"
        Loaded="OnViewLoaded">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
    <TextBlock Grid.Row="0" Text="任务下载选择（MES 作业工件）" FontSize="18" FontWeight="Bold"
               Foreground="#FFE8C4A0" Margin="0,0,0,12"/>

    <dg:DataGrid Grid.Row="1"
                 ItemsSource="{Binding DisplayTasks}"
                 AutoGenerateColumns="False"
                 CanUserReorderColumns="False"
                 CanUserResizeColumns="True"
                 GridLinesVisibility="All"
                 HeadersVisibility="Column"
                 IsReadOnly="False"
                 FontFamily="{StaticResource DefaultFont}">
      <dg:DataGrid.Columns>
        <dg:DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected}" Width="48"/>
        <!-- 协议 4.1 返回结果说明：trainType / trainNo / partCode / partType / taskId -->
        <dg:DataGridTextColumn Header="车型" Binding="{Binding ProjectNumber}" Width="120" IsReadOnly="True"/>
        <dg:DataGridTextColumn Header="车号" Binding="{Binding TrainNo}" Width="120" IsReadOnly="True"/>
        <dg:DataGridTextColumn Header="工件编号" Binding="{Binding CarCode}" Width="160" IsReadOnly="True"/>
        <dg:DataGridTextColumn Header="工件类型" Binding="{Binding ItemName}" Width="160" IsReadOnly="True"/>
        <dg:DataGridTextColumn Header="作业任务id" Binding="{Binding HoldTaskId}" Width="*" MinWidth="180" IsReadOnly="True"/>
      </dg:DataGrid.Columns>
    </dg:DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
      <CheckBox Content="全选" IsChecked="{Binding IsAllSelected}" Foreground="#FFF0F0F0"/>
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#FFCCCCCC"/>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,14,0,0">
      <Button Content="取消" Command="{Binding CancelCommand}" MinWidth="100" MinHeight="36"/>
      <Button Content="确定下载" Command="{Binding ConfirmDownloadCommand}" MinWidth="120" MinHeight="36"
              IsEnabled="{Binding !IsBusy}"/>
    </StackPanel>
  </Grid>
</Window>
