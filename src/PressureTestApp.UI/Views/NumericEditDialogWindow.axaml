<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PressureTestApp.UI.ViewModels"
        x:Class="PressureTestApp.UI.Views.NumericEditDialogWindow"
        x:DataType="vm:NumericEditDialogViewModel"
        Title="数值设定"
        Width="520" MinHeight="280" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        SystemDecorations="None"
        KeyDown="OnWindowKeyDown">

  <Border Background="{StaticResource BrushBgWindow}"
          BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
          CornerRadius="10" ClipToBounds="True"
          BoxShadow="0 16 48 0 #80000000">
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- 标题条 -->
      <Border Grid.Row="0" Background="{StaticResource BrushBgTitlebar}"
              BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
              Padding="14,12" PointerPressed="OnTitleBarPointerPressed">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="▣" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding TitleBarText}" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource BrushPrimary}" VerticalAlignment="Center"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="1" Margin="24,20,24,12" Spacing="16">
        <TextBlock Text="请输入数值" FontSize="14" Foreground="White"
                   HorizontalAlignment="Center"/>
        <TextBox x:Name="ValueTextBox" Text="{Binding EditValueText}"
                 FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                 Foreground="White" CaretBrush="White"
                 HorizontalContentAlignment="Center" TextAlignment="Center"
                 MinHeight="56" Padding="12,8"
                 Background="#FF2A2F37"
                 BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6"/>
        <TextBlock Text="{Binding ErrorHint}"
                   IsVisible="{Binding ErrorHint, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{StaticResource BrushDanger}" FontSize="13"
                   TextWrapping="Wrap" HorizontalAlignment="Center"/>
      </StackPanel>

      <Border Grid.Row="2" Background="#FF2F343D" BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="0,1,0,0" Padding="16,12">
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
          <Button MinWidth="100" MinHeight="38" Content="确定" Classes="primary"
                  Click="OnOkClick" IsDefault="True"/>
          <Button MinWidth="100" MinHeight="38" Content="取消"
                  Background="#FF3C4149" Foreground="{StaticResource BrushTextPrimary}"
                  BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6"
                  Click="OnCancelClick"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
