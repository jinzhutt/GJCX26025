<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PressureTestApp.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="420"
        x:Class="PressureTestApp.UI.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Width="640" Height="420"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="True"
        Title="加载中">

  <Border CornerRadius="14"
          Background="{StaticResource BrushBgWindow}"
          BoxShadow="0 16 48 0 #80000000"
          ClipToBounds="True">
    <Grid>
      <!-- 背景渐变光晕 -->
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="60%" RadiusY="60%">
            <GradientStop Offset="0" Color="#33EF9A4E"/>
            <GradientStop Offset="1" Color="#00EF9A4E"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">

        <!-- Logo -->
        <Border Width="96" Height="96" CornerRadius="22"
                Background="{StaticResource BrushPrimary}"
                BoxShadow="0 12 36 0 #59EF9A4E">
          <TextBlock Text="退卸" FontSize="30" FontWeight="Bold"
                     Foreground="{StaticResource BrushBgTitlebar}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 标题 -->
        <TextBlock Text="轴承退卸"
                   FontSize="26" FontWeight="Medium"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource BrushTextPrimary}"/>

        <TextBlock Text="Pressure Test Bench · V1.0.0"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource BrushTextTertiary}"/>

        <!-- 进度条 -->
        <ProgressBar Width="360" Height="4"
                     Value="{Binding ProgressValue}"
                     Maximum="100"
                     Margin="0,12,0,0"
                     Foreground="{StaticResource BrushPrimary}"
                     Background="{StaticResource BrushBgTitlebar}"/>

        <!-- 状态 -->
        <TextBlock Text="{Binding StatusText}"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource BrushTextSecondary}"/>
      </StackPanel>

      <!-- 版本号 -->
      <TextBlock Text="{Binding VersionText}"
                 FontSize="11"
                 Foreground="{StaticResource BrushTextDisabled}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,18,14"/>
    </Grid>
  </Border>
</Window>
