<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:PressureTestApp.UI.Converters"
             x:Class="PressureTestApp.UI.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PressureTestApp/Styles/Colors.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:NullToZeroConverter x:Key="NullToZeroConverter"/>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://Semi.Avalonia/Index.axaml"/>
    <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml"/>
    <!--<StyleInclude Source="avares://Irihi.Ursa.Themes.Semi/Index.axaml"/>-->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://PressureTestApp/Styles/Controls.axaml"/>
  </Application.Styles>

</Application>
