<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 工业深色主题配色（与 UI mockup 完全一致） -->
  <Color x:Key="ColorBgWindow">#FF2A2F37</Color>
  <Color x:Key="ColorBgPanel">#FF313640</Color>
  <Color x:Key="ColorBgSidebar">#FF1F232A</Color>
  <Color x:Key="ColorBgTitlebar">#FF1A1D23</Color>
  <Color x:Key="ColorBgInput">#FF2A2F37</Color>
  <Color x:Key="ColorBgHover">#0FFFFFFF</Color>

  <Color x:Key="ColorBorder">#FF3C424E</Color>
  <Color x:Key="ColorBorderHover">#FF5F5E5A</Color>
  <Color x:Key="ColorBorderActive">#FFEF9A4E</Color>

  <Color x:Key="ColorTextPrimary">#FFEBE3DD</Color>
  <Color x:Key="ColorTextSecondary">#FFB4B2A9</Color>
  <Color x:Key="ColorTextTertiary">#FF888780</Color>
  <Color x:Key="ColorTextDisabled">#FF5F5E5A</Color>

  <Color x:Key="ColorPrimary">#FFEF9A4E</Color>
  <Color x:Key="ColorPrimaryHover">#FFD4753C</Color>
  <Color x:Key="ColorSuccess">#FF6EBE28</Color>
  <Color x:Key="ColorWarning">#FFF4A261</Color>
  <Color x:Key="ColorDanger">#FFE14B4A</Color>
  <Color x:Key="ColorInfo">#FF85B7EB</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="BrushBgWindow" Color="{StaticResource ColorBgWindow}"/>
  <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource ColorBgPanel}"/>
  <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource ColorBgSidebar}"/>
  <SolidColorBrush x:Key="BrushBgTitlebar" Color="{StaticResource ColorBgTitlebar}"/>
  <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}"/>

  <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
  <SolidColorBrush x:Key="BrushBorderHover" Color="{StaticResource ColorBorderHover}"/>

  <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
  <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
  <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource ColorTextTertiary}"/>
  <SolidColorBrush x:Key="BrushTextDisabled" Color="{StaticResource ColorTextDisabled}"/>

  <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
  <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}"/>
  <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
  <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
  <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
  <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}"/>

  <!-- 字号 -->
  <x:Double x:Key="FsH1">22</x:Double>
  <x:Double x:Key="FsH2">17</x:Double>
  <x:Double x:Key="FsH3">15</x:Double>
  <x:Double x:Key="FsBody">14</x:Double>
  <x:Double x:Key="FsSmall">12</x:Double>
  <x:Double x:Key="FsTiny">11</x:Double>
  <x:Double x:Key="FsDisplay">36</x:Double>

  <!-- 字体（微软雅黑 + 跨平台兜底） -->
  <FontFamily x:Key="DefaultFont">Microsoft YaHei,微软雅黑,Source Han Sans CN,Noto Sans CJK SC,sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Consolas,JetBrains Mono,Courier New,monospace</FontFamily>

</ResourceDictionary>
